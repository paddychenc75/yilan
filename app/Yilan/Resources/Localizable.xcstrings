        }
      }
    },
    "%@ 无法直接写入，存为 PNG" : {
      "comment" : "保存菜单说明；%@ 是原格式名，例如 WebP",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can't be written directly — saving as PNG"
