{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "%@\n其他文件不受影响，可以继续浏览。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nOther files aren’t affected. You can keep browsing."
          }
        }
      }
    },
    "%@ 发布" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Released %@"
          }
        }
      }
    },
    "%@ 影片" : {
