{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "%@\n其他文件不受影响，可以继续浏览。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nOther files aren’t affected. You can keep browsing."
          }
        }
      }
    },
    "%@ · 原图不动" : {
      "comment" : "保存菜单：%@ 是副本文件名",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · original untouched"
          }
        }
      }
    },
    "%@ 发布" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Released %@"
          }
        }
      }
    },
    "%@ 导出" : {
      "comment" : "RAW 导出为 JPEG 的文件名（不含扩展名）；%@ 是原文件名",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ exported"
          }
        }
      }
    },
    "%@ 导出 %lld" : {
      "comment" : "RAW 导出为 JPEG 的文件名，重名时带序号；%1$@ 是原文件名，%2$lld 是序号",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ exported %lld"
          }
        }
      }
    },
    "%@ 影片" : {
      "comment" : "信息面板：视频格式名，%@ 是容器格式",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Movie"
          }
        }
      }
    },
    "%@ 无法直接写入" : {
      "comment" : "替换原图置灰的原因；%@ 是原格式名",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can't be written directly"
          }
        }
      }
    },
    "%@ 无法直接写入，存为 JPEG" : {
      "comment" : "保存菜单说明；%@ 是原格式名，例如 WebP",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can't be written directly — saving as JPEG"
