    },
    "一览" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yilan"
          }
        }
      }
    },
    "一览 %@ 现已发布" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yilan %@ is available"
          }
        }
      }
    },
    "一览不会自己修改这些设置，只有你拨开关才会改。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yilan never changes these on its own, only when you flip a switch."
          }
        }
      }
    },
    "一览只在检查更新时联网，不会上传任何信息。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yilan goes online only to check for updates and never sends any information."
          }
        }
      }
    },
    "一览可以打开 JPEG、PNG、HEIF、RAW、WebP、GIF、SVG、TIFF、MP4、MOV。\n也可以把其他文件夹拖到这里。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yilan can open JPEG, PNG, HEIF, RAW, WebP, GIF, SVG, TIFF, MP4 and MOV.\nYou can also drag another folder here."
          }
        }
      }
    },
